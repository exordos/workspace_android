<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="sharedpref" path="workspace_push_device.xml"/>
    <exclude domain="sharedpref" path="workspace_credentials.xml"/>
    <exclude domain="sharedpref" path="workspace_message_state.xml"/>
    <exclude domain="sharedpref" path="workspace_snapshot_crypto.xml"/>
    <exclude domain="file" path="datastore/settings.preferences_pb"/>
    <exclude domain="database" path="workspace_snapshot.db"/>
</full-backup-content>
